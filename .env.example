JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_another_long_random_secret
PORT=4000
DB_PATH=./database.db

# Google OAuth — get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# MetaMask / Crypto Payments — your ETH wallet address to receive payments
ADMIN_ETH_ADDRESS=0xYourEthereumWalletAddressHere
ADMIN_USDT_ADDRESS=0xYourEthereumWalletAddressHere
PAYMENT_NETWORK=mainnet
